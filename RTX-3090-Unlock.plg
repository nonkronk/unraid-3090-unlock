  <FILE Run="/bin/bash" Method="install">
    <INLINE><![CDATA[
set -u
root=/boot/config/plugins/RTX-3090-Unlock
tag=RTX-3090-Unlock
notify=/usr/local/emhttp/webGui/scripts/notify
# A boot entry this plugin configured blacklists NVIDIA autoload. On such a
# boot this script must never exit non-zero: Unraid would move the plugin to
# plugins-error, nothing would load NVIDIA on later boots, and the uninstaller
# that restores the boot options would no longer be reachable.
configured_boot=0
grep -q 'gpu_unlock.targets=' /proc/cmdline 2>/dev/null && configured_boot=1
notice() {  # notice SUBJECT MESSAGE
  echo "$tag: $2" >&2
  logger -t "$tag" -- "$2" 2>/dev/null || true
  if [ -x "$notify" ]; then
    "$notify" -e "RTX 3090 Unlock" -s "$1" -d "$2" -i warning >/dev/null 2>&1 || true
  fi
}
warn() { notice "GPU Unlock not active" "$*"; }
normal_driver() {
  if [ "$configured_boot" = 1 ] && [ ! -d /sys/module/nvidia ]; then
    modprobe nvidia || warn "NVIDIA fallback failed; boot the 'Unraid OS (No GPU Unlock)' entry or restore the Syslinux backup"
  fi
}
give_up() {
  warn "$1"
  normal_driver
  if [ "$configured_boot" = 1 ]; then
    exit 0
  fi
  exit 1
}
kernel=$(uname -r)
module="$root/payload/$kernel/gpu_unlock.ko"
vermagic=$(modinfo -F vermagic "$module" 2>/dev/null || true)
if [ ! -s "$module" ] || [ "${vermagic%% *}" != "$kernel" ]; then
  give_up "no gpu_unlock module for kernel $kernel; NVIDIA runs locked. Build one with scripts/build-local.sh and stage it in $root/payload/$kernel/"
fi
if [ ! -f "$root/runtime/prepare-firmware.sh" ] ||
   ! bash "$root/runtime/prepare-firmware.sh"; then
  give_up "local firmware setup failed; boot options not changed"
fi
python_hint="install 'Python 3 for UNRAID' from Apps, then try again"
if [ "$configured_boot" = 0 ] && ! command -v python3 >/dev/null 2>&1; then
  give_up "Python 3 is required to set up GPU Unlock: $python_hint"
fi
boot_status=0
if ! command -v python3 >/dev/null 2>&1; then
  # Stock Unraid has no Python; the Python plugin installs after this one at
  # boot. The early loader checks the same boot arguments in bash.
  echo "$tag: python3 not available yet; boot arguments are checked by the early loader"
elif [ -f "$root/runtime/configure-boot.py" ]; then
  boot_output=$(python3 "$root/runtime/configure-boot.py" 2>&1) || boot_status=1
  echo "$boot_output"
else
  boot_output="boot setup failed: configure-boot.py is missing"
  boot_status=1
fi
if [ "$boot_status" != 0 ]; then
  reason=${boot_output##*boot setup failed: }
  reason=${reason:-unknown error}
  if [ "$configured_boot" = 1 ]; then
    # Keep running so the unlock and NVIDIA still start on this boot.
    notice "Boot configuration check failed" "$reason. GPU Unlock still runs on this boot."
  else
    give_up "boot configuration check failed: $reason; boot options not changed"
  fi
fi
if [ -f "$root/runtime/early-load.sh" ]; then
  bash "$root/runtime/early-load.sh" || normal_driver
else
  warn "early loader missing; initializing normal NVIDIA"
  normal_driver
fi
exit 0
    ]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
root=/boot/config/plugins/RTX-3090-Unlock
# Restore boot options first. Never unload/reset a live GPU.
if [ ! -f "$root/runtime/configure-boot.py" ]; then
  echo "RTX-3090-Unlock: cannot safely uninstall: rollback helper missing" >&2
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "RTX-3090-Unlock: uninstall needs Python 3 to restore boot options: install 'Python 3 for UNRAID' from Apps, then remove again" >&2
  exit 1
fi
if ! python3 "$root/runtime/configure-boot.py" --disable; then
  echo "RTX-3090-Unlock: uninstall refused; boot options were NOT changed" >&2
  exit 1
fi
rm -rf /usr/local/emhttp/plugins/RTX-3090-Unlock
echo "RTX-3090-Unlock: boot options restored; no reboot was performed"
exit 0
    ]]></INLINE>
  </FILE>
</PLUGIN>
