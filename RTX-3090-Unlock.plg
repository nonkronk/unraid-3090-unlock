<?xml version="1.0" standalone="yes"?>
<PLUGIN name="RTX-3090-Unlock"
        author="nonkronk"
        version="2026.10.25"
        pluginURL="https://raw.githubusercontent.com/nonkronk/unraid-3090-unlock/main/RTX-3090-Unlock.plg"
        support="https://github.com/nonkronk/unraid-3090-unlock/issues"
        icon="microchip">
  <CHANGES>
    ###2026.10.25
    - Self-contained installation via Plugins / Install Plugin URL.
    - Include one prebuilt module; accept a separately staged module matching the running kernel.
    - New supported setups receive a boot backup and separate fallback entry; legacy setups can be adopted without rewriting boot options.
    - No automatic reboot or live GPU reset.
  </CHANGES>

  <FILE Name="/boot/config/plugins/RTX-3090-Unlock/payload/6.18.58-Unraid/gpu_unlock.ko">
    <URL>https://github.com/nonkronk/unraid-3090-unlock/releases/download/v2026.10.25/gpu_unlock-6.18.58-Unraid.ko</URL>
  </FILE>
  <FILE Name="/boot/config/plugins/RTX-3090-Unlock/runtime/early-load.sh">
    <URL>https://raw.githubusercontent.com/nonkronk/unraid-3090-unlock/7d4951dcae216126df5c72b38109e1b9c4cbcace/runtime/early-load.sh</URL>
  </FILE>
  <FILE Name="/boot/config/plugins/RTX-3090-Unlock/runtime/prepare-firmware.sh">
    <URL>https://raw.githubusercontent.com/nonkronk/unraid-3090-unlock/7d4951dcae216126df5c72b38109e1b9c4cbcace/runtime/prepare-firmware.sh</URL>
  </FILE>
  <FILE Name="/boot/config/plugins/RTX-3090-Unlock/runtime/configure-boot.py">
    <URL>https://raw.githubusercontent.com/nonkronk/unraid-3090-unlock/7d4951dcae216126df5c72b38109e1b9c4cbcace/runtime/configure-boot.py</URL>
  </FILE>

  <FILE Run="/bin/bash" Method="install">
    <INLINE><![CDATA[
set -u
root=/boot/config/plugins/RTX-3090-Unlock
normal_driver() {
  if grep -q 'gpu_unlock.targets=' /proc/cmdline; then
    modprobe nvidia || echo "RTX-3090-Unlock: NVIDIA fallback failed; check the Syslinux boot options" >&2
  fi
}
kernel=$(uname -r)
module="$root/payload/$kernel/gpu_unlock.ko"
vermagic=$(modinfo -F vermagic "$module" 2>/dev/null || true)
if [ ! -s "$module" ] || [ "${vermagic%% *}" != "$kernel" ]; then
  echo "RTX-3090-Unlock: no matching module staged for $kernel. Build one using scripts/build-local.sh on a Linux build host." >&2
  normal_driver
  exit 1
fi
if [ ! -f "$root/runtime/prepare-firmware.sh" ] ||
   ! bash "$root/runtime/prepare-firmware.sh"; then
  echo "RTX-3090-Unlock: local firmware setup failed; boot options not changed" >&2
  normal_driver
  exit 1
fi
if [ ! -f "$root/runtime/configure-boot.py" ] ||
   ! python3 "$root/runtime/configure-boot.py"; then
  echo "RTX-3090-Unlock: boot configuration validation failed" >&2
  normal_driver
  exit 1
fi
if [ -f "$root/runtime/early-load.sh" ]; then
  bash "$root/runtime/early-load.sh" || normal_driver
else
  echo "RTX-3090-Unlock: early loader missing; initializing normal NVIDIA" >&2
  normal_driver
fi
exit 0
    ]]></INLINE>
  </FILE>

  <FILE Run="/bin/bash" Method="remove">
    <INLINE><![CDATA[
root=/boot/config/plugins/RTX-3090-Unlock
# Restore boot options first. Never unload/reset a live GPU.
if [ ! -f "$root/runtime/configure-boot.py" ]; then
  echo "RTX-3090-Unlock: cannot safely uninstall: rollback helper missing" >&2
  exit 1
fi
if ! python3 "$root/runtime/configure-boot.py" --disable; then
  echo "RTX-3090-Unlock: uninstall refused; boot options were NOT changed" >&2
  exit 1
fi
echo "RTX-3090-Unlock: boot options restored; no reboot was performed"
exit 0
    ]]></INLINE>
  </FILE>
</PLUGIN>
